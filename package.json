{
  "name": "vixify",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file=.env build/main.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "deploy": "ssh pi bash vixify/deploy.sh",
    "format": "prettier . --write"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.0",
    "discordx": "^11.13.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
